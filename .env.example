# La API es independiente de la suscripción ChatGPT.
# No subas tu archivo .env a repositorios ni lo compartas.
OPENAI_API_KEY=
VISION_MODEL=gpt-4o-mini
VISION_INTERVAL_SECONDS=8
# Opcional: servidor OpenAI-compatible, p. ej. un servidor local. Compatibilidad variable.
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
VOSK_MODEL_PATH=models/vosk-es
